; Ebon Hawk Desktop — M0 foundation. Engine version is enforced by tools/dev.py.
config_version=5

[application]
config/name="Ebon Hawk Desktop"
run/main_scene="res://scenes/placeholder_room.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.05, 1)

[debug]
file_logging/enable_file_logging=false
